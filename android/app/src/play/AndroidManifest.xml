<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Restricted permissions the Play build does not use -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <!-- User-granted "Alarms & reminders" access on every Android version -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:remove="android:maxSdkVersion" />

    <application>
        <service android:name=".SyncService" tools:node="remove" />
        <!-- WorkManager only needs this for setForeground(), which is not used -->
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />
    </application>
</manifest>
